# MessageBird Configuration
MESSAGEBIRD_ENV=live

# SIGNING KEY
MESSAGEBIRD_SIGN=

# Live Environment
MESSAGEBIRD_API_KEY_LIVE=
MESSAGEBIRD_WORKSPACE_ID_LIVE=

# Test Environment
MESSAGEBIRD_API_KEY_TEST=
MESSAGEBIRD_WORKSPACE_ID_TEST=

# Production Environment
MESSAGEBIRD_API_KEY_PRODUCTION=
MESSAGEBIRD_WORKSPACE_ID_PRODUCTION=

# Channel IDs
MESSAGEBIRD_CHANNEL_ID_WHATSAPP=
MESSAGEBIRD_CHANNEL_ID_MESSENGER=
MESSAGEBIRD_CHANNEL_ID_TELEGRAM=

# Base URLs
MESSAGEBIRD_BASE_URL_CONVERSATIONS=https://conversations.messagebird.com/v1
MESSAGEBIRD_BASE_URL_CONTACTS=https://contacts.messagebird.com/v2
MESSAGEBIRD_BASE_URL_BIRD=https://api.bird.com

# Application Configuration
MESSAGEBIRD_RESULT_LIMIT=20
MESSAGEBIRD_DB_FILENAME=m_bird.db
MESSAGEBIRD_LOG_LEVEL=INFO
MESSAGEBIRD_HTTP_TIMEOUT=30.0

# Timezone and Localization
MESSAGEBIRD_TIMEZONE_OFFSET=-3

# Bot Phrase Configuration (used for parsing triagem/screening data)
MESSAGEBIRD_PHRASE_TRIAGEM_HEADER="=== Dados da Triagem ==="
MESSAGEBIRD_PHRASE_TICKET_HEADER="=== Informações Ticket ==="

# Software Names (comma-separated list for auto-tagging/reporting)
MESSAGEBIRD_SOFTWARE_NAMES="SOFTWARE_A,SOFTWARE_B"

# Path to custom business configuration (JSON) for DEPT/REASON/OCCURRENCE maps
MESSAGEBIRD_BUSINESS_CONFIG_PATH="business_config.json"

# SLA Configuration
MESSAGEBIRD_SLA_FR_SECONDS=300
MESSAGEBIRD_SLA_RES_HOURS=24
MESSAGEBIRD_SLA_MAX_MSGS=50
MESSAGEBIRD_SLA_MIN_CONCURRENT=5
