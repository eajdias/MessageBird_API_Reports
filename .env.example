# Live Environment
MESSAGEBIRD_API_KEY_LIVE=
MESSAGEBIRD_WORKSPACE_ID_LIVE=

# Test Environment
MESSAGEBIRD_API_KEY_TEST=
MESSAGEBIRD_WORKSPACE_ID_TEST=

# Base URLs
MESSAGEBIRD_BASE_URL_CONVERSATIONS=https://conversations.messagebird.com/v1
MESSAGEBIRD_BASE_URL_CONTACTS=https://contacts.messagebird.com/v2
MESSAGEBIRD_BASE_URL_BIRD=https://api.bird.com

# Application Configuration
MESSAGEBIRD_DB_FILENAME=m_bird.db
MESSAGEBIRD_HTTP_TIMEOUT=30.0

# Timezone and Localization (offset em horas em relacao ao UTC; ex.: -3 para Brasília)
MESSAGEBIRD_TIMEZONE_OFFSET=-3

# Bot Phrase Configuration (used for parsing triagem/screening data)
MESSAGEBIRD_PHRASE_TRIAGEM_HEADER="=== Dados da Triagem ==="
MESSAGEBIRD_PHRASE_TICKET_HEADER="=== Informações Ticket ==="

# Software Names (comma-separated list for auto-tagging/reporting)
MESSAGEBIRD_SOFTWARE_NAMES="SOFTWARE_A,SOFTWARE_B"
